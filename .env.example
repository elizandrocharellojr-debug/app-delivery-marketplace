HOST=0.0.0.0
PUBLIC_HOST=192.168.3.13
PORT=3000
PUBLIC_APP_URL=http://192.168.3.13:3000
EMAIL_FROM=Alloo <no-reply@seudominio.com>
RESEND_API_KEY=coloque_sua_chave_aqui

# Pagamento online (Mercado Pago) - Pix e cartao de credito/debito.
# Pegue essas duas chaves em Suas integracoes > Dados da integracao > Testes
# > Credenciais de teste, dentro de mercadopago.com.br/developers.
# Sem essas duas chaves preenchidas, o pagamento online fica desativado
# e o app continua funcionando normalmente com os outros metodos (cartao
# na entrega, dinheiro).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Login com Google - alternativa ao arquivo google-config.json (util em
# hospedagens como Railway, onde e mais facil configurar por variavel de
# ambiente). Se ambos estiverem preenchidos, o arquivo tem prioridade.
GOOGLE_CLIENT_ID=

# Notificacoes push - alternativa ao arquivo push-config.json (mesma ideia
# do Google acima). Gere as chaves com "npx web-push generate-vapid-keys".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Senha da conta de administrador (usuario "Elizandro"), usada so na
# primeira vez que o banco sobe vazio. Escolha uma senha forte - nunca
# deixe isso vazio nem coloque a senha direto no server.js.
# Pra trocar a senha de uma conta que ja existe, defina esse valor e rode
# "npm run set-admin-password".
ADMIN_PASSWORD=
